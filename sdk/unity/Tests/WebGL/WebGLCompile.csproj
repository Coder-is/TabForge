<!-- Compiles the WebGL-only branch of the transports (UNITY_WEBGL) against
     stubs of the two Unity types it uses. Build only; nothing runs. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);UNITY_WEBGL</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/ProtocolCore.cs" Link="ProtocolCore.cs" />
    <Compile Include="../../Runtime/JsonSyntax.cs" Link="JsonSyntax.cs" />
    <Compile Include="../../Runtime/WireValidator.cs" Link="WireValidator.cs" />
    <Compile Include="../../Runtime/SseParser.cs" Link="SseParser.cs" />
    <Compile Include="../../Runtime/RealtimeCodec.cs" Link="RealtimeCodec.cs" />
    <Compile Include="../../Runtime/RealtimeClient.cs" Link="RealtimeClient.cs" />
    <Compile Include="../../Runtime/ClientWebSocketTransport.cs" Link="ClientWebSocketTransport.cs" />
    <Compile Include="../../Runtime/WebGLWebSocketTransport.cs" Link="WebGLWebSocketTransport.cs" />
    <Compile Include="UnityStubs.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
