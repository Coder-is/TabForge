{
  "name": "tabforge",
  "displayName": "TabForge",
  "description": "Export Excel/CSV and Proto projects with the portable TabForge compiler.",
  "version": "0.5.0",
  "publisher": "tabforge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:tabforge.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "tabforge.export",
        "title": "TabForge: \u5bfc\u51fa\u9879\u76ee"
      },
      {
        "command": "tabforge.check",
        "title": "TabForge: \u6821\u9a8c\u9879\u76ee"
      },
      {
        "command": "tabforge.report",
        "title": "TabForge: \u67e5\u770b\u6700\u8fd1\u62a5\u544a"
      }
    ],
    "configuration": {
      "title": "TabForge",
      "properties": {
        "tabforge.exportOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically export when project source files change."
        },
        "tabforge.toolPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a TabForge executable. Portable project tools and bundled tools are detected automatically."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/tabforge.json",
        "url": "./tabforge.schema.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test extension.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Coder-is/TabForge.git",
    "directory": "editors/vscode"
  }
}
